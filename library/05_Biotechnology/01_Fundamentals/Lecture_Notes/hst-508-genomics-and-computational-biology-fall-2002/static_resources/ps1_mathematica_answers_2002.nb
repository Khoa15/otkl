Cell[TextData[StyleBox["When we are in the 8 cycle regime, we need to start \
with nearly the same initial condition to make the histories coincide. Try \
starting with 0.55, and 0.56 for h1 and h2.  In this case the convergence is \
slow enough to generate an interesting plot.",
  FontColor->RGBColor[1, 0.501961, 1]]], "Input",
  Evaluatable->False,
  FormatType->TextForm],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(\[IndentingNewLine]\)\(\(Clear[fg];\)\[IndentingNewLine]
    r\  = \ 3.562\[IndentingNewLine]
    \(fg[x_]\  := \ r\ x \((1 - x)\);\)\[IndentingNewLine]
    \(h1\  = \ NestList[fg, \ 0.50, \ 1000];\)\[IndentingNewLine]
    \(h2\  = \ NestList[fg, \ 0.55, \ 1000];\)\[IndentingNewLine]
    \(ListPlot[h2 - h1, \ PlotJoined\  \[Rule] False];\)\)\)\)], "Input"],

Cell[BoxData[
    \(3.562`\)], "Output"],

