Cell[TextData[StyleBox["In the chaotic regime of the logistic function, any \
two points eventualy have divergent histories. You may not always see it \
though, due to calculation precision limits. One way to get Mathematica to \
use, say 400 digits of precision is to put `400 in front of the numbers. If \
you increase precision from 400 digits to say, 800, the graph will remain \
chaotic longer.",
  FontColor->RGBColor[1, 0.501961, 1]]], "Input",
  Evaluatable->False],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(Clear[fg];\)\), "\[IndentingNewLine]", 
    \(\(r\  = \ 3.989`400;\)\), "\[IndentingNewLine]", 
    \(\(fg[x_]\  := \ r\ x \((1 - x)\);\)\), "\[IndentingNewLine]", 
    \(\(h1\  = \ 
        NestList[fg, \ 0.700000000000000000000`400, \ 
          1000];\)\), "\[IndentingNewLine]", 
    \(\(h2\  = \ 
        NestList[fg, \ 0.700000000000000010000`400, \ 
          1000];\)\), "\[IndentingNewLine]", 
    \(\(ListPlot[h2 - h1, \ PlotJoined\  \[Rule] False];\)\)}], "Input"],

