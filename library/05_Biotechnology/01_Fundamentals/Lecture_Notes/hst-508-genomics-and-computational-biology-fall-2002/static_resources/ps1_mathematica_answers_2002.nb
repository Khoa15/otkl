Cell[TextData[StyleBox["The parameters below show a period 4 cycle. \
Substituting in r = 3.4 will show a period two,  and r = 3.562 will show a \
period 8 cycle.  These cycles show up better by selecting large g and by \
setting PlotJoined->False. Starting with s near k eliminates pre-convergence \
noise as well.",
  FontColor->RGBColor[1, 0.501961, 1]]], "Input",
  Evaluatable->False,
  FormatType->TextForm],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(\[IndentingNewLine]\)\(Clear\ [pop]\n
    \(r\  = \ 3.51;\)\n
    \(k\  = \ 1000;\)\n
    \(g\  = \ 1000;\)\n
    \(s\  = \ 1000;\)\n
    \(pop[t_]\  := \ \(pop[t]\  = \ 
          r\ pop[t - 1] \((1 - \ pop[t - 1]/k)\)\);\)\n
    \(pop[0]\  = \ 5;\)\n
    \(dt\  = Table[pop[x], \ {x, 0, g, 1}];\)\n
    ListPlot[dt, \ PlotJoined\  \[Rule] False, \ 
      PlotRange \[Rule] {k/4, \ k}]\)\)\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
