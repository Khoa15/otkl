Cell[TextData[{
  StyleBox["Its r values just under four show chaos. There are actually a few \
values that have limit cycles that are not powers of two. If you pick an r \
value close enough to one of them, you can easily see them.",
    FontColor->RGBColor[1, 0.501961, 1]],
  "\n"
}], "Input",
  Evaluatable->False,
  FormatType->TextForm],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(\[IndentingNewLine]\)\(Clear\ [pop]\n
    \(r\  = \ 3.97;\)\n
    \(k\  = \ 1000;\)\n
    \(g\  = \ 1000;\)\n
    \(s\  = \ 1000;\)\n
    \(pop[t_]\  := \ \(pop[t]\  = \ 
          r\ pop[t - 1] \((1 - \ pop[t - 1]/k)\)\);\)\n
    \(pop[0]\  = \ 5;\)\n
    \(dt\  = Table[pop[x], \ {x, 0, g, 1}];\)\n
    ListPlot[dt, \ PlotJoined\  \[Rule] False, \ 
      PlotRange \[Rule] {0, \ 3  k/2}]\)\)\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
