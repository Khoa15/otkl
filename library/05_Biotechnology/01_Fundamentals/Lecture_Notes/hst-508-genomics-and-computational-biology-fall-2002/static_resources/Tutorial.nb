Cell[CellGroupData[{

Cell["Manipulate vectors and matrices", "Section"],

Cell[TextData[{
  "Vectors in ",
  StyleBox["Mathematica", "TI"],
  " are represented by lists. The dot product of two vectors ",
  StyleBox["u",
    FontFamily->"Courier"],
  " and ",
  StyleBox["v",
    FontFamily->"Courier"],
  " is indicated by ",
  StyleBox["u.v", "MR"],
  ". "
}], "Text",
  CellTags->{"S1.8.3", "3.2"}],

Cell[CellGroupData[{

Cell[BoxData[
    \({1, 2, 3}\  . \ {a, b, c}\)], "Input"],

Cell[BoxData[
    \(a + 2\ b + 3\ c\)], "Output"]
}, Open  ]],

Cell["\<\
Without the dot, the vectors are multiplied component-by-component.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \({1, 2, 3}\ {a, b, c}\)], "Input"],

Cell[BoxData[
    \({a, 2\ b, 3\ c}\)], "Output"]
}, Open  ]],

Cell["\<\
Matrices are represented by lists of lists. This gives the inverse of a 2 \
\[Cross] 2 matrix. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Inverse[{{1, 2}, {2, 3}}]\)], "Input"],

Cell[BoxData[
    \({{\(-3\), 2}, {2, \(-1\)}}\)], "Output"]
}, Open  ]],

Cell["\<\
The dot product of a matrix with its inverse gives the identity matrix. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \({{1, 2}, {2, 3}}\  . \ %\)], "Input"],

Cell[BoxData[
    \({{1, 0}, {0, 1}}\)], "Output"]
}, Open  ]],

Cell["\<\
You can easily calculate the eigenvalues or eigenvectors of a matrix.\
\>", "Text",
  CellTags->{"S3.7.9", "9.3"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(Eigenvalues[{{1, 2}, {2, 3}}]\)], "Input"],

Cell[BoxData[
    \({2 - \@5, 2 + \@5}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define your own functions", "Section",
  CellTags->"FunctionSyntax"],

Cell[TextData[{
  "The following defines a function ",
  StyleBox["f",
    FontFamily->"Courier"],
  ". Note the underscore in ",
  StyleBox["x_",
    FontFamily->"Courier"],
  " and the ",
  StyleBox[":=",
    FontFamily->"Courier"],
  " sign. "
}], "Text",
  CellTags->{"S1.7.1", "1.2"}],

Cell[BoxData[
    \(f[x_] := Expand[\((1 + x)\)^2]\)], "InputOnly"],

Cell[TextData[{
  "You can give variables, numbers, or symbolic expressions as arguments to \
",
  StyleBox["f",
    FontFamily->"Courier"],
  ". "
}], "Text",
  CellTags->{"S1.7.1", "1.4"}],

Cell[CellGroupData[{

Cell[BoxData[
    \({f[x], f[1.1], f[a + b]}\)], "Input"],

Cell[BoxData[
    \({1 + 2\ x + x\^2, 4.41`, 
      1 + 2\ a + a\^2 + 2\ b + 2\ a\ b + b\^2}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "If you use ",
  StyleBox["x",
    FontFamily->"Courier"],
  " instead of ",
  StyleBox["x_",
    FontFamily->"Courier"],
  " in defining a function ",
  StyleBox["g",
    FontFamily->"Courier"],
  ", the definition will apply only to the literal expression ",
  StyleBox["g[x]",
    FontFamily->"Courier"],
  ", not to all expressions of the form ",
  StyleBox["g[_]",
    FontFamily->"Courier"],
  ". "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(g[x] := Expand[\((1 + x)\)^2]; \ {g[x], g[1.1], g[a + b]}\)], "Input"],

Cell[BoxData[
    \({1 + 2\ x + x\^2, g[1.1`], g[a + b]}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "If you use ",
  StyleBox["=",
    FontFamily->"Courier"],
  " instead of ",
  StyleBox[":=",
    FontFamily->"Courier"],
  ", the right-hand side of your definition will be evaluated immediately,",
  " ",
  "rather than each time the function is called. "
}], "Text",
  ShowCellBracket->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(h[x_] = Expand[\((1 + x)\)^2]; {h[x], h[1.1], h[a + b]}\)], "Input"],

Cell[BoxData[
    \({1 + 2\ x + x\^2, 4.41`, 
      1 + 2\ \((a + b)\) + \((a + b)\)\^2}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Manipulate data", "Section"],

Cell[TextData[{
  "This generates a list of 2000 elements containing a periodic signal with \
random noise added. The function ",
  StyleBox["Random[]",
    FontFamily->"Courier"],
  " gives a random real number between 0 and 1. The function ",
  StyleBox["ListPlot",
    FontFamily->"Courier"],
  " plots a list of numbers. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(data = Table[Sin[n] + \ Random[] - 1/2, {n, 0, 20,  .02}]; \ 
    ListPlot[data];\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
