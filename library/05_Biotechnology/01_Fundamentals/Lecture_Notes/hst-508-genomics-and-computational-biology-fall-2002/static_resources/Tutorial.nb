Cell[CellGroupData[{

Cell["Use pattern matching to transform expressions", "Section"],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " is based on the unifying principle that everything can be treated as a \
symbolic expression. Expressions",
  " ",
  "are of the form ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          StyleBox["Head",
            FontSlant->"Italic"], 
          StyleBox["[",
            FontFamily->"Courier"], 
          RowBox[{
            SubscriptBox[
              StyleBox["arg",
                FontSlant->"Italic"], "1"], 
            StyleBox[",",
              FontFamily->"Courier"], 
            SubscriptBox[
              StyleBox["arg",
                FontSlant->"Italic"], "2"], 
            StyleBox[",",
              FontFamily->"Courier"], 
            StyleBox["\[Ellipsis]",
              FontFamily->"Courier"]}], 
          StyleBox["]",
            FontFamily->"Courier"]}], TraditionalForm]]],
  ", where the ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          StyleBox["arg",
            FontSlant->"Italic"], "i"], TraditionalForm]]],
  " can themselves be expressions. All operations in ",
  StyleBox["Mathematica\[LongDash]",
    FontSlant->"Italic"],
  "whether numeric, symbolic, or otherwise\[LongDash]can be thought of as \
transformations of expressions. "
}], "Text",
  CellTags->"T.12"],

Cell[BoxData[GridBox[{
        {
          StyleBox["Object",
            "SO"], 
          StyleBox["Example",
            "SO"], 
          StyleBox["Representation",
            "SO"]},
        {
          StyleBox[\(A\ list\ of\ elements\),
            "TR"], 
          StyleBox[\({a, b, c}\),
            FontFamily->"Courier",
            FontWeight->"Bold"], 
          RowBox[{" ", 
            StyleBox[\(List[a, b, c]\),
              FontFamily->"Courier",
              FontWeight->"Bold"]}]},
        {
          StyleBox[\(An\ algebraic\ expression\),
            "TR"], 
          StyleBox[\(x^2 + 1\),
            FontFamily->"Courier",
            FontWeight->"Bold"], 
          RowBox[{" ", 
            StyleBox[\(Plus[1, Power[x, 2]]\),
              FontFamily->"Courier",
              FontWeight->"Bold"]}]},
        {
          StyleBox[\(An\ equation\),
            "TR"], 
          StyleBox[\(x == Sin[x]\),
            FontFamily->"Courier",
            FontWeight->"Bold"], 
          RowBox[{" ", 
            StyleBox[\(Equal[x, Sin[x]]\),
              FontFamily->"Courier",
              FontWeight->"Bold"]}]}
        },
      RowLines->{True, False}]], "DefinitionBox3Col"],

Cell[TextData[{
  "The symbol _ (called \[OpenCurlyDoubleQuote]blank\[CloseCurlyDoubleQuote]) \
can stand for any expression. So for example the pattern _^_ stands for any \
explicit power. The function ",
  StyleBox["Cases",
    FontFamily->"Courier"],
  " gives the elements of a list that match a specified pattern. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Cases[{1, x^2, E^3, 2^\(t^3\), 4}, _^_]\)], "Input"],

Cell[BoxData[
    \({x\^2, \[ExponentialE]\^3, 2\^\(t\^3\)}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can name a piece of a pattern to pull it out of an expression. In the \
pattern ",
  StyleBox["_^n_",
    FontFamily->"Courier"],
  " the exponent is named ",
  StyleBox["n",
    FontFamily->"Courier"],
  "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Cases[{1, x^2, E^3, 2^\(t^3\), 4}, _^n_ \[Rule] n]\)], "Input"],

Cell[BoxData[
    \({2, 3, t\^3}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "This shows how you can use patterns to transform expressions. Here the \
pattern ",
  StyleBox["x_",
    FontFamily->"Courier"],
  " ",
  StyleBox["+",
    FontFamily->"Courier"],
  " ",
  StyleBox["y_",
    FontFamily->"Courier"],
  " stands for the sum of two terms."
}], "Text",
  CellTags->"T.12"],

Cell[CellGroupData[{

Cell[BoxData[
    \({a + b, a + b + c} /. x_ + y_ -> x\^2 + y\^2\)], "Input",
  CellTags->"T.12"],

Cell[BoxData[
    \({a\^2 + b\^2, a\^2 + \((b + c)\)\^2}\)], "Output"]
}, Open  ]]
}, Open  ]]
},
FrontEndVersion->"4.2 for Microsoft Windows",
ScreenRectangle->{{0, 1280}, {0, 941}},
WindowSize->{495, 740},
WindowMargins->{{24, Automatic}, {Automatic, 30}}
]

