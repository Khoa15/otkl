Cell[CellGroupData[{

Cell["Do integrals and derivatives", "Section"],

Cell[TextData[{
  "Here is the integral ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          StyleBox["\[Integral]",
            SpanMinSize->3], \(\(1\/\(x\^4 - a\^4\)\) \[DifferentialD]x\)}], 
        TraditionalForm]]],
  ". The result has no constant of integration."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Integrate[1/\((x^4 - a^4)\), x]\)], "Input"],

Cell[BoxData[
    \(\(-\(ArcTan[x\/a]\/\(2\ a\^3\)\)\) + Log[a - x]\/\(4\ a\^3\) - 
      Log[a + x]\/\(4\ a\^3\)\)], "Output"]
}, Open  ]],

Cell["This differentiates the previous result. ", "Text",
  CellTags->{"S1.5.2", "2.3"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(D[%, x]\)], "Input"],

Cell[BoxData[
    \(\(-\(1\/\(4\ a\^3\ \((a - x)\)\)\)\) - 1\/\(4\ a\^3\ \((a + x)\)\) - 
      1\/\(2\ a\^4\ \((1 + x\^2\/a\^2)\)\)\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can use ",
  StyleBox["Simplify", "MR"],
  " to get back the original integrand. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Simplify[%]\)], "Input"],

Cell[BoxData[
    \(1\/\(\(-a\^4\) + x\^4\)\)], "Output"]
}, Open  ]],

Cell[TextData[{
  StyleBox["Integrate", "MR"],
  " also works for definite integrals, as well as for multiple integrals. ",
  StyleBox["NIntegrate", "MR"],
  " finds numerical approximations. Here is the definite integral ",
  Cell[BoxData[
      FormBox[
        RowBox[{\(\[Integral]\_0\%1\), 
          RowBox[{\(\@\(2 - x\^2 - x\^6\)\), 
            StyleBox["dx",
              "TI"]}]}], TraditionalForm]]],
  ". "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(NIntegrate[\@\(2 - x^2 - x^6\), {x, 0, 1}]\)], "Input",
  CellTags->"S1.5.3"],

Cell[BoxData[
    \(1.2056595439510003`\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Give values to variables", "Section",
  CellTags->"FunctionSyntax"],

Cell["\<\
Use = to assign values to variables. You can put several commands on one line \
by separating them with semicolons. The commands are executed in sequence, \
with the output being the result of the last command.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(x = 3; y = x + 1; \ Sqrt[x^2 + y^2]\)], "Input"],

Cell[BoxData[
    \(5\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Values you assign to variables are kept until you explicitly clear them\
\[LongDash]or end your ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " session. Here you might have expected an algebraic expansion, but instead \
you get a number, since ",
  StyleBox["x",
    FontFamily->"Courier"],
  " and ",
  StyleBox["y",
    FontFamily->"Courier"],
  " still have the numerical values they were assigned above."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Expand[\((x + y)\)^5]\)], "Input"],

Cell[BoxData[
    \(16807\)], "Output"]
}, Open  ]],

Cell["\<\
To avoid such unexpected behavior, it is good to clear the values of \
variables as soon as you have finished using them.\
\>", "Text",
  CellTags->{"S1.2.2", "2.9"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(Clear[x, y]; Expand[\((x + y)\)^5]\)], "Input"],

Cell[BoxData[
    \(x\^5 + 5\ x\^4\ y + 10\ x\^3\ y\^2 + 10\ x\^2\ y\^3 + 5\ x\ y\^4 + 
      y\^5\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "In ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  ", you can avoid all these issues by using transformation rules. The rule \
",
  StyleBox["x", "MR"],
  " \[Rule] ",
  StyleBox["3", "MR"],
  " represents \[OpenCurlyDoubleQuote]",
  StyleBox["x", "MR"],
  " gets replaced by ",
  StyleBox["3", "MR"],
  "\[CloseCurlyDoubleQuote]. Here the ",
  StyleBox["/.", "MR"],
  " applies this rule to the expression before it\[LongDash]but does not \
assign a value to ",
  StyleBox["x", "MR"],
  " in the process. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(1 + x^2 + x^4 + x^5 /. x \[Rule] 3\)], "Input"],

Cell[BoxData[
    \(334\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve equations symbolically", "Section"],

Cell[TextData[{
  StyleBox["E", "TI",
    FontSlant->"Plain"],
  "quations are written with ",
  StyleBox["==",
    FontFamily->"Courier"],
  " notation. The second argument of ",
  StyleBox["Solve",
    FontFamily->"Courier"],
  " is the variable to be solved for. Solutions are returned as rules of the \
form ",
  StyleBox["x",
    FontFamily->"Courier"],
  " \[Rule] ",
  StyleBox["value",
    FontSlant->"Italic"],
  ". "
}], "Text",
  CellTags->{"S1.5.7", "7.8"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[x^2 + x \[Equal] a, x]\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] 1\/2\ \((\(-1\) - \@\(1 + 4\ a\))\)}, {x \[Rule] 
          1\/2\ \((\(-1\) + \@\(1 + 4\ a\))\)}}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "The ",
  StyleBox["=",
    FontFamily->"Courier"],
  " operator is reserved for assigning values to variables. If you use ",
  StyleBox["=",
    FontFamily->"Courier"],
  " instead of ",
  StyleBox["==",
    FontFamily->"Courier"],
  ", ",
  StyleBox["Solve",
    FontFamily->"Courier"],
  " warns you, but you may still have inadvertently set the value of a \
variable. "
}], "Text"],

Cell["\<\
You can solve equations involving more than one variable. In the output, each \
sublist represents one solution.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[{x\^2 - k\^2 == 0, y\^2 == x\^2}, {x, y}]\)], "Input",
  CellTags->"Solve"],

Cell[BoxData[
    \({{x \[Rule] \(-k\), y \[Rule] \(-k\)}, {x \[Rule] \(-k\), 
        y \[Rule] k}, {x \[Rule] k, y \[Rule] \(-k\)}, {x \[Rule] k, 
        y \[Rule] k}}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  StyleBox["Solve", "MR"],
  " can also handle equations involving more complicated functions. "
}], "Text",
  CellTags->{"S1.5.7", "7.10"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[Log[\@x] == \@Log[x], x]\)], "Input",
  CellTags->"Solve"],

Cell[BoxData[
    \({{x \[Rule] 1}, {x \[Rule] \[ExponentialE]\^4}}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve equations numerically ", "Section"],

Cell[TextData[{
  "You can use ",
  StyleBox["NSolve", "MR"],
  " to find numerical approximations to the roots of a polynomial equation. "
}], "Text",
  CellTags->{"S1.6.3", "3.2"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(solutions = NSolve[x^3 + x + 1 \[Equal] 0, x]\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] \(-0.6823278038280193`\)}, {x \[Rule] \
\(\(0.34116390191400964`\)\(\[InvisibleSpace]\)\) - 
            1.161541399997252`\ \[ImaginaryI]}, {x \[Rule] \
\(\(0.34116390191400964`\)\(\[InvisibleSpace]\)\) + 
            1.161541399997252`\ \[ImaginaryI]}}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  StyleBox["NSolve",
    FontFamily->"Courier"],
  " returns a list of rules. To get a list of numbers for ",
  "x",
  " instead, you just apply these rules to x using the ",
  StyleBox["/.",
    FontFamily->"Courier"],
  " operator. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(x /. solutions\)], "Input"],

Cell[BoxData[
    \({\(-0.6823278038280193`\), \
\(\(0.34116390191400964`\)\(\[InvisibleSpace]\)\) - 
        1.161541399997252`\ \[ImaginaryI], \(\(0.34116390191400964`\)\(\
\[InvisibleSpace]\)\) + 1.161541399997252`\ \[ImaginaryI]}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  StyleBox["NSolve", "MR"],
  " also finds numerical solutions to systems of simultaneous equations. "
}], "Text",
  CellTags->{"S1.6.3", "3.3"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(NSolve[{x + y \[Equal] 2, x - 3  y + z \[Equal] 3, 
        x - y + z \[Equal] 0}, {x, y, z}]\)], "Input"],

Cell[BoxData[
    \({{x \[Rule] 3.5`, y \[Rule] \(-1.5`\), z \[Rule] \(-5.`\)}}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "For non-polynomial equations, you can use ",
  StyleBox["FindRoot", "MR"],
  " to search for solutions. The argument ",
  StyleBox["{x,", "MR"],
  " ",
  StyleBox["1}", "MR"],
  " tells ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " to search for a numerical solution starting at ",
  StyleBox["x",
    FontFamily->"Courier"],
  " = 1. "
}], "Text",
  CellTags->{"S1.6.3", "3.4"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(FindRoot[3  Cos[x] \[Equal] Log[x], {x, 1}]\)], "Input"],

Cell[BoxData[
    \({x \[Rule] 1.4472586172777895`}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve differential equations", "Section"],

Cell["\<\
Here is the symbolic solution to a simple differential equation with an \
initial condition. \
\>", "Text",
  CellTags->{"S1.5.8", "8.3"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(DSolve[{\(y'\)[x] \[Equal] a\ y[x] + 1, y[0] \[Equal] 0}, y[x], 
      x]\)], "Input"],

Cell[BoxData[
    \({{y[x] \[Rule] \(\(-1\) + \[ExponentialE]\^\(a\ x\)\)\/a}}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Here is a numerical solution to a nonlinear differential equation. The \
result is a rule for the function y. ",
  StyleBox["InterpolatingFunction",
    FontFamily->"Courier"],
  " represents a numerical function containing numerical data indicated by ",
  StyleBox["<>",
    FontFamily->"Courier"],
  ". "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(result = 
      NDSolve[{\(y''\)[t] + 0.1\ \(y'\)[t] == \(-Sin[y[t]]\), 
          y[0] == 1, \(y'\)[0] == 0}, y, {t, 0, 50}]\)], "Input",
  CellTags->"NDSolve"],

Cell[BoxData[
    RowBox[{"{", 
      RowBox[{"{", 
        RowBox[{"y", "\[Rule]", 
          TagBox[\(InterpolatingFunction[{{0.`, 50.`}}, "<>"]\),
            False,
            Editable->False]}], "}"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can use ",
  StyleBox["/.",
    FontFamily->"Courier"],
  " to apply the rule for the function y. This makes a plot by evaluating ",
  StyleBox["y[x]",
    FontFamily->"Courier"],
  " for a range of values of x. "
}], "Text",
  CellTags->"NDSolve"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(Plot[y[x] /. result, {x, 0, 30}];\)\)], "Input"],

