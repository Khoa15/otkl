(*WindowFrame->Normal*)



Notebook[{

Cell[CellGroupData[{
Cell["Do interactive calculations using notebooks", "Section",
  CellTags->"ShiftReturn"],

Cell[TextData[{
  "You normally interact with ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " through documents called notebooks. This tutorial is an example of a \
notebook. Notebooks can have many forms.",
  " ",
  "But typically they consist of cells that can contain text, calculations, \
or graphics."
}], "Text"],

Cell[TextData[{
  "Cells are indicated by brackets on the right. This cell is a text cell.",
  " ",
  "Input for ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " to evaluate goes in input cells. "
}], "Text"],

Cell[TextData[{
  "To create a new input cell, just click outside an existing cell and start \
typing. When you have finished, press ",
  StyleBox["\[ShiftKey]\[KeyBar]\[EnterKey].", "KeyStroke"],
  " ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " evaluates your input and puts the result in an output cell immediately \
underneath."
}], "Text"],

Cell[TextData[{
  "Here is a sample calculation. Your cursor can be anywhere in the input \
cell when you press ",
  StyleBox["\[ShiftKey]\[KeyBar]\[EnterKey]", "KeyStroke"],
  ".",
  " ",
  "The ",
  StyleBox["In[", "SR",
    FontSize->10],
  StyleBox["n", "SR",
    FontSize->10,
    FontSlant->"Italic"],
  StyleBox["]:=", "SR",
    FontSize->10],
  " and ",
  StyleBox["Out[", "SR",
    FontSize->10],
  StyleBox["n", "SR",
    FontSize->10,
    FontSlant->"Italic"],
  StyleBox["]=", "SR",
    FontSize->10],
  " labels are added automatically."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(5 + 3\)], "Input"],

Cell[BoxData[
    \(8\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can edit existing input and press ",
  StyleBox["\[ShiftKey]\[KeyBar]\[EnterKey]", "KeyStroke"],
  " to re-evaluate it. The new result replaces the old one in the output \
cell. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(264/4\)], "Input"],

Cell[BoxData[
    \(66\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Go ahead and change some of the numbers in the input cell above. Then \
press ",
  StyleBox["\[ShiftKey]\[KeyBar]\[EnterKey]", "KeyStroke"],
  " to redo the calculation.",
  " "
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Get started just like using a calculator", "Section",
  CellTags->"ShiftReturn"],

Cell[TextData[{
  "To interact with ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  ",",
  " ",
  "type in your input, then press ",
  StyleBox["\[ShiftKey]\[KeyBar]\[EnterKey]", "KeyStroke"],
  " to get your output. If you press ",
  StyleBox["\[EnterKey]", "KeyStroke"],
  " on its own, you just go to a new line. In the example below, the ",
  StyleBox["^", "MR"],
  " indicates the operation of taking a power. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(19^50\)], "Input"],

Cell[BoxData[
    \(8663234049605954426644038200675212212900743262211018069459689001\)], \
"Output"]
}, Open  ]],

Cell[TextData[{
  "If you put an explicit decimal point in your input, then ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " gives you an approximate numerical result. Very large and very small \
numbers are then shown in exponential notation."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(19. ^50\)], "Input"],

Cell[BoxData[
    \(8.663234049605955`*^63\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Use either a space or an explicit ",
  StyleBox["*",
    FontFamily->"Courier"],
  " to indicate multiplication. \nTyping a semicolon at the end of your input \
prevents output from being displayed. "
}], "Text",
  CellTags->"ShiftReturn"],

Cell[BoxData[
    \(\(2^20\ \ \ 3^20;\)\)], "InputOnly",
  CellTags->"ShiftReturn"],

Cell[TextData[{
  "You can use ",
  StyleBox["%", "MR"],
  " to stand for the result of the last calculation you did.",
  " ",
  "This works regardless of where that calculation appears\[LongDash]whether \
in the same notebook or another one."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Sqrt[%]\)], "Input",
  CellTags->"ShiftReturn"],

Cell[BoxData[
    \(60466176\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Choose from over a thousand built-in functions", "Section",
  CellTags->"FunctionSyntax"],

Cell["\<\
All built-in functions work the same: their names start with capital letters, \
and their arguments are in square brackets. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(Log[2, 8]\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \(3\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Functions can be nested. You can use I or \[ImaginaryI] to represent ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(\@\(-1\)\)\(.\)\)\)]],
  " To enter \[ImaginaryI], type ",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  "ii",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  ", where ",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  " is the E",
  StyleBox["SCAPE",
    Magnification->0.75],
  " key. "
}], "Text",
  CellTags->"FunctionSyntax"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Cos[ArcSin[I\ x]]\)], "Input",
  CellTags->"FunctionSyntax"],

Cell[BoxData[
    \(\@\(1 + x\^2\)\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "All but the most common functions and commands have names that are spelled \
out completely. The constant \[Pi] is represented by the built-in symbol Pi. \
You can also enter it as \[Pi] by typing ",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  "p",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  "."
}], "Text",
  CellTags->"FunctionSyntax"],

Cell[CellGroupData[{

Cell[BoxData[
    \(IntegerPart[Pi^2]\)], "Input",
  CellTags->"FunctionSyntax"],

Cell[BoxData[
    \(9\)], "Output"]
}, Open  ]],

Cell["\<\
The power is placed after the function arguments, not before. So the first \
term here is correct but the second is not. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Sin[Pi/4]^3\  + \ \(\(Sin^3[Pi/4]\)\(\ \)\)\)], "Input"],

Cell[BoxData[
    \(1\/\(2\ \@2\) + Sin\^3[\[Pi]\/4]\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Do numerical calculations to any precision", "Section",
  CellTags->"NumericalValues"],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " gives exact results for integer computations, regardless of how many \
digits are needed.",
  " ",
  "The ",
  StyleBox["\[Continuation]", "MR"],
  " here indicates continuation to the next line. "
}], "Text",
  CellTags->"NumericalValues"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(125!\)\)], "Input"],

Cell[BoxData[
    \(188267717688892609974376770249160085759540364871492425887598231508353156\
331613598866882932889495923133646405445930057740630161919341380597818883457558\
547055524326375565007131770880000000000000000000000000000000\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can use ",
  StyleBox["N", "MR"],
  " to get an approximate numerical result. Recall that ",
  StyleBox["%", "MR"],
  " stands for the last result. "
}], "Text",
  CellTags->"NumericalValues"],

Cell[CellGroupData[{

Cell[BoxData[
    \(N[%]\)], "Input"],

Cell[BoxData[
    \(1.882677176888926`*^209\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can use E or \[ExponentialE] to represent the exponential constant ",
  StyleBox["e",
    FontSlant->"Italic"],
  ". To enter \[ExponentialE], type ",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  "ee",
  StyleBox["\[EscapeKey]", "KeyStroke"],
  "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(N[E]\)], "Input"],

Cell[BoxData[
    \(2.718281828459045`\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "You can specify how many digits to generate in a calculation. Here is the \
value of ",
  StyleBox["e",
    FontSlant->"Italic"],
  " to 60 digits. "
}], "Text",
  CellTags->"NumericalValues"],

Cell[CellGroupData[{

Cell[BoxData[
    \(N[E, 60]\)], "Input"],

Cell[BoxData[
    \(2.7182818284590452353602874713526624977572470936999595749669676277240766\
3`60\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Do symbolic calculations to get formulas", "Section"],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " works with symbolic expressions as well as numbers. Parentheses control \
the grouping of arithmetic operations.",
  " ",
  "Note that the product of ",
  StyleBox["a", "MR"],
  " and ",
  StyleBox["b", "MR"],
  " is written as ",
  StyleBox["a", "MR"],
  " ",
  StyleBox["b", "MR"],
  ".Without a space ",
  StyleBox["ab",
    FontFamily->"Courier"],
  " is a single variable. "
}], "Text",
  CellTags->{"SF2.5", "5.5"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(Expand[\((a\ b - c\ d)\)^2 + \((a\ d + b\ c)\)^2]\)], "Input"],

Cell[BoxData[
    \(a\^2\ b\^2 + b\^2\ c\^2 + a\^2\ d\^2 + c\^2\ d\^2\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Factor[%]\)], "Input"],

Cell[BoxData[
    \(\((a\^2 + c\^2)\)\ \((b\^2 + d\^2)\)\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "The function ",
  StyleBox["Simplify", "MR"],
  " uses various methods to reduce expressions to their simplest forms."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Simplify[Cos[x]^4 - Sin[x]^4]\)], "Input"],

Cell[BoxData[
    \(Cos[2\ x]\)], "Output"]
}, Open  ]],

Cell[TextData[{
  StyleBox["FullSimplify", "MR"],
  " is a more powerful version of ",
  StyleBox["Simplify", "MR"],
  ", but it can take longer."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(FullSimplify[Gamma[z]\ Gamma[1 - z]]\)], "Input"],

Cell[BoxData[
    \(\[Pi]\ Csc[\[Pi]\ z]\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Use lists to represent collections of things", "Section"],

Cell["\<\
Lists are used, for example, to represent vectors, matrices, tensors, sets, \
ranges of integrals and plots, and groups of arguments in functions. Lists \
are given in curly brackets and their elements are separated by commas. \
\>", "Text"],

Cell[TextData[{
  "A common way to generate a list is with the ",
  StyleBox["Table", "MR"],
  " command. Here ",
  StyleBox["{x,", "MR"],
  StyleBox[" ", "MR",
    FontFamily->"Times"],
  StyleBox["2", "MR"],
  StyleBox[",", "MR"],
  " ",
  StyleBox["10}", "MR"],
  " is also a list, which specifies that ",
  StyleBox["x", "MR"],
  " goes from 2 to 10. If ",
  StyleBox["x", "MR"],
  " starts at ",
  StyleBox["1", "MR"],
  ", you can use ",
  StyleBox["{x,", "MR"],
  " ",
  StyleBox["10}", "MR"],
  " instead. "
}], "Text",
  CellTags->{"S1.8.1", "1.2"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(Table[2^x, {x, 2, 10}]\)], "Input"],

Cell[BoxData[
    \({4, 8, 16, 32, 64, 128, 256, 512, 1024}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "A matrix is a list of lists. The ",
  StyleBox["=", "MR"],
  " sign is used to define ",
  StyleBox["mx", "MR"],
  ", a 3 \[Cross] 5 matrix. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(mx = Table[a\ x^b, {a, 3}, {b, 5}]\)], "Input"],

Cell[BoxData[
    \({{x, x\^2, x\^3, x\^4, x\^5}, {2\ x, 2\ x\^2, 2\ x\^3, 2\ x\^4, 
        2\ x\^5}, {3\ x, 3\ x\^2, 3\ x\^3, 3\ x\^4, 3\ x\^5}}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  "Use ",
  StyleBox["Part[m, ", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`i\)]],
  StyleBox[", ", "MR"],
  StyleBox["j",
    FontSlant->"Italic"],
  StyleBox["]", "MR"],
  " to get the element in the ",
  Cell[BoxData[
      \(TraditionalForm\`i\)]],
  "th row and ",
  StyleBox["j",
    FontSlant->"Italic"],
  "th column of a matrix ",
  StyleBox["m.", "MR"],
  " The short notation ",
  StyleBox["m[[", "MR"],
  Cell[BoxData[
      \(TraditionalForm\`i\)]],
  StyleBox[", ", "MR"],
  StyleBox["j",
    FontSlant->"Italic"],
  StyleBox["]]", "MR"],
  " works as well. ",
  "You can use lists to group multiple results together."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \({Part[mx, 2, 3], mx[\([2, 3]\)]}\)], "Input"],

Cell[BoxData[
    \({2\ x\^3, 2\ x\^3}\)], "Output"]
}, Open  ]],

Cell["\<\
Mathematical functions automatically get applied to every element in a list. \
\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Sin[Pi/{2, 3, 4, 5, 6, 7}]\)], "Input"],

Cell[BoxData[
    \({1, \@3\/2, 1\/\@2, 1\/2\ \@\(1\/2\ \((5 - \@5)\)\), 1\/2, 
      Sin[\[Pi]\/7]}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Create 2D and 3D graphics", "Section"],

Cell[TextData[{
  "Here is a plot of a function of one variable. The list ",
  StyleBox["{x,", "MR"],
  StyleBox[" ", "MR"],
  StyleBox["0,", "MR"],
  StyleBox[" ", "MR"],
  StyleBox["4}", "MR"],
  " specifies the range of the plot. "
}], "Text",
  CellTags->{"S0.4.1", "1.2"}],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(Plot[Sin[Exp[x]], {x, 0, 4}];\)\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
