Cell[TextData[StyleBox["In the cell below, we determine the combinations of \
our two nullspace spanning vectors that produce all positive fluxes.",
  FontFamily->"Comic Sans MS",
  FontSize->9]], "Input",
  FormatType->TextForm],

Cell[CellGroupData[{

Cell[BoxData[{
    StyleBox[\(Clear[AllPlus]\),
      FontSize->9], "\[IndentingNewLine]", 
    StyleBox[\(AllPlus[
          a_]\ \  := \ \[IndentingNewLine]Block[\[IndentingNewLine]{br}, \
\[IndentingNewLine]br\  = \ 1; \[IndentingNewLine]For[i\  = \ 1, \ 
            i\  \[LessEqual] \ Length[a], \ \(i++\), \[IndentingNewLine]If[
              a[\([i]\)]\  < \ 0, \ 
              br = 0, , ]\[IndentingNewLine]]; \ \[IndentingNewLine]br\
\[IndentingNewLine]]\),
      FontSize->9], "\[IndentingNewLine]", 
    StyleBox[\(a\  = \ {\(-2\), 1, 1, \(-2\), 1, 1, 0, 2};\),
      FontSize->9], "\[IndentingNewLine]", 
    StyleBox[\(b\  = \ {8, 1, \(-1\), 8, 1, \(-1\), 2, 0};\),
      FontSize->9], "\[IndentingNewLine]", 
    StyleBox[\(VVs\  = 
          Table[AllPlus[x\ a\  + \ y\ b], \ {x, \ \(-1\), \ 5, \ 
              0.2}, \ {y, \ \(-1\), \ 5, \ 0.2}];\),
      FontSize->9], "\[IndentingNewLine]", 
    StyleBox[\(ListDensityPlot[VVs, \ PlotLabel \[Rule] "\<(a,b)\>", 
          MeshRange \[Rule] {{\(-1\), \ 5}, \ {\(-1\), 5}}];\),
      FontSize->9]}], "Input"],

Cell[GraphicsData["PostScript", "\<\
