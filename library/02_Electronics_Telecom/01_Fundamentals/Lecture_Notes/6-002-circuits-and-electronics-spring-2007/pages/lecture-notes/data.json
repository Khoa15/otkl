_l21/index.html\">PDF</a>)\n</td>\n</p>\n<p></tr>\n\n<tr>\n\n<td>\n\n22\n</td>\n\n<td>\n\nEnergy and power\n</td>\n\n<td>\n\n(<a href=\"../../resources/6002_l22/index.html\">PDF</a>)\n</td>\n</p>\n<p></tr>\n\n<tr>\n\n<td>\n\n23\n</td>\n\n<td>\n\nEnergy, CMOS\n</td>\n\n<td>\n\n(<a href=\"../../resources/6002_l23/index.html\">PDF</a>)\n</td>\n</p>\n<p></tr>\n\n<tr>\n\n<td>\n\n24\n</td>\n\n<td>\n\nPower conversion circuits and diodes\n</td>\n\n<td>\n\n \n</td>\n</p>\n<p></tr>\n\n<tr>\n\n<td>\n\n25\n</td>\n\n<td>\n\nViolating the abstraction barrier\n</td>\n\n<td>\n\n(<a href=\"../../resources/6002_l25/index.html\">PDF</a>)\n</td>\n</p>\n</tr>\n\n</table>\n\n",
