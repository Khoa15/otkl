  "content": "<p>Lecture slides are available for selected topics. Please also see the <a href=\"../../resources/mit2_017j_f09_coursetextbook_pdf/index.html\">course textbook</a> for extensive notes.</p>\n<p><table>\n<thead>\n<tr>\n<th>\n\nTOPICS\n</th>\n<th>\n\nSLIDES\n</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>\n\nConcepts of design\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_design/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nExperiments, tests, and data\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_experiments/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nElectronics essentials\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_electronics/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nDesign for the ocean environment\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_oceans/index.html\">PDF - 2.2MB</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nApplying optimization\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_optimization/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nStability and trim\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_stability/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nGeneral presentation guidelines\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_presntations/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nCorrosion in marine environments\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_corrosion/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nImportant vehicle power sources\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_power/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nTopics in machine elements\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_machines/index.html\">PDF - 1.1MB</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nNavigation sensors and systems\n</td>\n<td>\n\n(<a href=\"../../resources/mit2_017jf09_navigation/index.html\">PDF</a>)\n</td>\n</tr>\n<tr>\n<td>\n\nBasic physics of underwater acoustics\n</td>\n<td>\n\n(<a href=\"../../resource